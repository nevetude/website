# Settings of the API (`src/music_backend/config.py`). Copy to `.env` in this folder to change one;
# every variable is optional, the values below are the defaults.

# The database of the compose file in the root of the repository.
DATABASE_URL=postgresql+asyncpg://music:music@localhost:5432/music

# The public API of Genius that the importer reads (no token is needed).
GENIUS_BASE_URL=https://genius.com/api
# The pause between the starts of two requests, in seconds (0.2 is five a second). A 429 stops the import.
GENIUS_MIN_INTERVAL_S=0.2
# The pause before the first retry of a failed request; it grows with each further attempt.
GENIUS_RETRY_BACKOFF_S=2.0

# Local-only shortcut: every request acts as the user `admin`. Turn it off when real login exists.
DEV_AUTO_LOGIN=true
